{
  "name": "alive",
  "version": "0.4.0",
  "private": true,
  "homepage": "https://ab-und-zu.github.io/alive",
  "dependencies": {
    "@react-spring/three": "~9.6.1",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.9",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.104",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "body-scroll-lock": "^4.0.0-beta.0",
    "ecs": "^0.21.0",
    "javascript-astar": "^0.4.1",
    "jsfxr": "^1.2.2",
    "o9n": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1",
    "simplex-noise": "^4.0.3",
    "three": "^0.169.0",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "FAST_REFRESH=false react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:fast": "CI=true react-scripts test --watchAll=false --testPathIgnorePatterns='\\.slow\\.test\\.'",
    "test:slow": "CI=true react-scripts test --watchAll=false --testPathPattern='\\.slow\\.test\\.'",
    "test:all": "CI=true react-scripts test --watchAll=false",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsbuildinfo",
    "lint": "eslint src --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/",
    "check:fast": "npm run --silent typecheck && npm run --silent lint && npm run --silent test:fast",
    "eject": "react-scripts eject",
    "prepare": "git config core.hooksPath .githooks || true",
    "media:titles": "node scripts/regenerate-titles.cjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "ignorePatterns": [
      "src/engine/vendor/"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(ecs|remove-array-items|three/src)/)"
    ]
  },
  "prettier": {
    "trailingComma": "es5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@react-three/test-renderer": "^8.2.4",
    "@types/body-scroll-lock": "^3.1.2",
    "@types/javascript-astar": "^0.0.35",
    "prettier": "^2.8.8"
  }
}
